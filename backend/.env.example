# Flask configuration
SECRET_KEY=skincare-ai-super-secret-key-2026-secure
JWT_SECRET_KEY=jwt-skincare-ai-secret-key-2026
PORT=5000

# Database Configuration (MySQL)
# Default is: mysql+pymysql://root:password@localhost:3306/skincare_ai
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=skincare_ai

# Or directly provide full connection URL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skincare_ai
# If MySQL is not running, the application automatically falls back to local SQLite:
# DATABASE_URL=sqlite:///skincare_ai.db

# SMTP Email Service Configuration (Optional, for Live OTP delivery)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

